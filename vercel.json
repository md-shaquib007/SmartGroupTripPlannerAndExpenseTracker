{
  "version": 2,
  "name": "tripsync",
  "builds": [
    {
      "src": "src/main/webapp/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/src/main/webapp/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/src/main/webapp/js/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/src/main/webapp/sw.js",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate",
        "service-worker-allowed": "/"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "/src/main/webapp/manifest.json"
    },
    {
      "src": "/api/health",
      "dest": "/src/main/webapp/api/health/index.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/src/main/webapp/robots.txt"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/src/main/webapp/index.html"
    }
  ]
}
